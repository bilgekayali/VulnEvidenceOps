{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vulnevidenceops.dev/v1/integration-handoff.schema.json",
  "title": "Digest-bound integration handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "profile", "producer_system", "consumer_system", "relationship", "payload_type", "payload_sha256", "subject_ref", "peer_contract", "created_at", "valid_until", "synthetic", "non_claims"],
  "properties": {
    "schema_version": {"const": "vulnevidenceops.integration-handoff.v1"},
    "handoff_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["ai-threat-evaluation", "datagovops-control-evidence", "doraops-operational-control-evidence", "modelriskops-assurance-evidence"]},
    "producer_system": {"enum": ["ai-threat-detection-framework", "datagovops", "doraops", "modelriskops", "vulnevidenceops"]},
    "consumer_system": {"enum": ["ai-threat-detection-framework", "datagovops", "doraops", "modelriskops", "vulnevidenceops"]},
    "relationship": {"enum": ["alert_evaluation_evidence", "control_evidence", "model_security_assurance_evidence", "operational_control_evidence"]},
    "payload_type": {"type": "string", "minLength": 1},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_ref": {"type": "string", "minLength": 1},
    "peer_contract": {"$ref": "peer-contract-identity.schema.json"},
    "created_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "synthetic": {"type": "boolean"},
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_safety_established", "consumer_acceptance_established", "cross_system_identity_established", "delivery_established", "payload_schema_conformance_established", "payload_truth_established", "peer_contract_semantic_compatibility_established", "peer_repository_authenticity_established", "producer_authority_established", "production_interoperability_established", "regulatory_compliance_established"],
      "properties": {
        "artifact_safety_established": {"const": false},
        "consumer_acceptance_established": {"const": false},
        "cross_system_identity_established": {"const": false},
        "delivery_established": {"const": false},
        "payload_schema_conformance_established": {"const": false},
        "payload_truth_established": {"const": false},
        "peer_contract_semantic_compatibility_established": {"const": false},
        "peer_repository_authenticity_established": {"const": false},
        "producer_authority_established": {"const": false},
        "production_interoperability_established": {"const": false},
        "regulatory_compliance_established": {"const": false}
      }
    }
  }
}
