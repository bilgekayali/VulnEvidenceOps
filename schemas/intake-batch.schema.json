{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vulnevidenceops.dev/v1/intake-batch.schema.json",
  "title": "Vulnerability intake batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intake_id", "adapter", "observed_at", "source_document_sha256", "mapping_context_sha256", "source_artifact", "findings", "mappings", "non_claims"],
  "properties": {
    "schema_version": {"const": "vulnevidenceops.intake-batch.v1"},
    "intake_id": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "source_format", "source_format_version"],
      "properties": {
        "adapter_id": {"enum": ["cyclonedx-1.5", "cyclonedx-1.6", "sarif-2.1.0"]},
        "adapter_version": {"const": "vulnevidenceops.intake.v1"},
        "source_format": {"enum": ["cyclonedx", "sarif"]},
        "source_format_version": {"enum": ["1.5", "1.6", "2.1.0"]}
      },
      "allOf": [
        {
          "if": {"properties": {"source_format": {"const": "sarif"}}},
          "then": {
            "properties": {
              "adapter_id": {"const": "sarif-2.1.0"},
              "source_format_version": {"const": "2.1.0"}
            }
          }
        },
        {
          "if": {"properties": {"source_format": {"const": "cyclonedx"}}},
          "then": {
            "properties": {
              "adapter_id": {"enum": ["cyclonedx-1.5", "cyclonedx-1.6"]},
              "source_format_version": {"enum": ["1.5", "1.6"]}
            }
          }
        }
      ]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "source_document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapping_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_artifact": {"$ref": "https://schemas.vulnevidenceops.dev/v1/evidence-reference.schema.json"},
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://schemas.vulnevidenceops.dev/v1/vulnerability-finding.schema.json"}
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://schemas.vulnevidenceops.dev/v1/intake-mapping.schema.json"}
    },
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_identity_established", "scanner_accuracy_established", "scanner_coverage_established", "severity_correctness_established", "source_artifact_authenticity_established", "vulnerability_presence_established"],
      "properties": {
        "asset_identity_established": {"const": false},
        "scanner_accuracy_established": {"const": false},
        "scanner_coverage_established": {"const": false},
        "severity_correctness_established": {"const": false},
        "source_artifact_authenticity_established": {"const": false},
        "vulnerability_presence_established": {"const": false}
      }
    }
  }
}
