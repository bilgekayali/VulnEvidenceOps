{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vulnevidenceops.dev/v1/control-evidence-matrix.schema.json",
  "title": "Control/evidence matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "controls", "non_claims"],
  "properties": {
    "schema_version": {"const": "vulnevidenceops.control-evidence-matrix.v1"},
    "matrix_id": {"type": "string", "minLength": 1},
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "objective", "required_record_types", "framework_references"],
        "properties": {
          "control_id": {"type": "string", "pattern": "^VEO-[A-Z]{3}-[0-9]{3}$"},
          "objective": {"type": "string", "minLength": 1},
          "required_record_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "framework_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated_compliance_score", "framework_applicability_determined", "production_control_effectiveness_proven"],
      "properties": {
        "automated_compliance_score": {"const": false},
        "framework_applicability_determined": {"const": false},
        "production_control_effectiveness_proven": {"const": false}
      }
    }
  }
}
