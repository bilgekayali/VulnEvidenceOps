{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vulnevidenceops.dev/v1/verification-record.schema.json",
  "title": "Verification record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verification_id", "finding_id", "performed_at", "verifier_role", "outcome", "method", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "vulnevidenceops.verification-record.v1"},
    "verification_id": {"type": "string", "minLength": 1},
    "finding_id": {"type": "string", "minLength": 1},
    "performed_at": {"type": "string", "format": "date-time"},
    "verifier_role": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["effective", "partial", "ineffective"]},
    "method": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
