{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vulnevidenceops.dev/v1/signed-evidence-envelope.schema.json",
  "title": "Signed evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "payload_type", "payload_base64", "payload_sha256", "key_id", "algorithm", "signed_at", "signature_base64"],
  "properties": {
    "schema_version": {"const": "vulnevidenceops.signed-evidence-envelope.v1"},
    "payload_type": {"type": "string", "minLength": 1},
    "payload_base64": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key_id": {"type": "string", "minLength": 1},
    "algorithm": {"const": "ed25519"},
    "signed_at": {"type": "string", "format": "date-time"},
    "signature_base64": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
  }
}
