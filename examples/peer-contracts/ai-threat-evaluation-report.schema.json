{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bilgekayali/ai-threat-detection-framework/schemas/evaluation-report.schema.json",
  "title": "AI Threat Detection Evaluation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_version",
    "input_schema_version",
    "dataset",
    "runtime",
    "evaluation",
    "risk_bands",
    "holdout_metrics",
    "limitations",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "ai-threat-detection.evaluation-report.v1"},
    "package_version": {"const": "1.0.0"},
    "input_schema_version": {"const": "ai-threat-detection.alert-input.v1"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "rows",
        "positive_rate",
        "first_event_utc",
        "last_event_utc"
      ],
      "properties": {
        "source_sha256": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "rows": {"type": "integer", "minimum": 40},
        "positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "first_event_utc": {"type": "string", "format": "date-time"},
        "last_event_utc": {"type": "string", "format": "date-time"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "ai_threat_detection_framework",
        "numpy",
        "pandas",
        "scikit_learn"
      ],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "ai_threat_detection_framework": {"const": "1.0.0"},
        "numpy": {"type": "string", "minLength": 1},
        "pandas": {"type": "string", "minLength": 1},
        "scikit_learn": {"type": "string", "minLength": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split_strategy",
        "training_rows",
        "test_rows",
        "test_size",
        "random_seed",
        "features",
        "model",
        "blend"
      ],
      "properties": {
        "split_strategy": {"const": "chronological_holdout"},
        "training_rows": {"type": "integer", "minimum": 20},
        "test_rows": {"type": "integer", "minimum": 10},
        "test_size": {"type": "number", "minimum": 0.1, "maximum": 0.5},
        "random_seed": {"type": "integer"},
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "estimators", "min_samples_leaf", "class_weight"],
          "properties": {
            "algorithm": {"const": "RandomForestClassifier"},
            "estimators": {"type": "integer", "minimum": 1},
            "min_samples_leaf": {"type": "integer", "minimum": 1},
            "class_weight": {"type": "string", "minLength": 1}
          }
        },
        "blend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_weight", "rule_weight"],
          "properties": {
            "model_weight": {"type": "number", "minimum": 0, "maximum": 1},
            "rule_weight": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "risk_bands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "medium", "high"],
      "properties": {
        "low": {"type": "string", "minLength": 1},
        "medium": {"type": "string", "minLength": 1},
        "high": {"type": "string", "minLength": 1}
      }
    },
    "holdout_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_baseline", "supervised_model", "blended_score"],
      "properties": {
        "rule_baseline": {"$ref": "#/$defs/metrics"},
        "supervised_model": {"$ref": "#/$defs/metrics"},
        "blended_score": {"$ref": "#/$defs/metrics"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "non_claims": {"$ref": "#/$defs/nonClaims"}
  },
  "$defs": {
    "nullableScore": {
      "anyOf": [
        {"type": "null"},
        {"type": "number", "minimum": 0, "maximum": 1}
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_threshold",
        "precision",
        "recall",
        "f1",
        "roc_auc",
        "average_precision",
        "brier_score",
        "confusion_matrix"
      ],
      "properties": {
        "decision_threshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "precision": {"type": "number", "minimum": 0, "maximum": 1},
        "recall": {"type": "number", "minimum": 0, "maximum": 1},
        "f1": {"type": "number", "minimum": 0, "maximum": 1},
        "roc_auc": {"$ref": "#/$defs/nullableScore"},
        "average_precision": {"$ref": "#/$defs/nullableScore"},
        "brier_score": {"type": "number", "minimum": 0, "maximum": 1},
        "confusion_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["true_negative", "false_positive", "false_negative", "true_positive"],
          "properties": {
            "true_negative": {"type": "integer", "minimum": 0},
            "false_positive": {"type": "integer", "minimum": 0},
            "false_negative": {"type": "integer", "minimum": 0},
            "true_positive": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "nonClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_detection_performance_determined",
        "production_readiness_determined",
        "regulatory_compliance_determined",
        "autonomous_containment_authorised"
      ],
      "properties": {
        "production_detection_performance_determined": {"const": false},
        "production_readiness_determined": {"const": false},
        "regulatory_compliance_determined": {"const": false},
        "autonomous_containment_authorised": {"const": false}
      }
    }
  }
}
