{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Control Evidence Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "institution_id",
    "matrix_id",
    "matrix_version",
    "rows",
    "represented_control_count",
    "gap_control_count",
    "revalidation_required_control_count",
    "state",
    "generated_at",
    "requires_human_review",
    "automated_compliance_scoring_enabled",
    "framework_applicability_determined",
    "control_effectiveness_determined",
    "legal_compliance_determined",
    "regulatory_compliance_determined",
    "supervisory_acceptance_determined",
    "schema_version"
  ],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "matrix_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "matrix_version": {"type": "integer", "minimum": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "control_version",
          "domain",
          "control_digest",
          "assessment_digest",
          "state",
          "evidence_reference_digests",
          "missing_evidence_types",
          "stale_evidence_types"
        ],
        "properties": {
          "control_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "control_version": {"type": "integer", "minimum": 1},
          "domain": {
            "enum": [
              "data_governance",
              "bcbs239_assurance",
              "privacy_security",
              "recovery_resilience",
              "deployment_runtime",
              "release_integrity"
            ]
          },
          "control_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "assessment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "state": {"enum": ["represented", "gap", "revalidation_required"]},
          "evidence_reference_digests": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "missing_evidence_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "stale_evidence_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "represented_control_count": {"type": "integer", "minimum": 0},
    "gap_control_count": {"type": "integer", "minimum": 0},
    "revalidation_required_control_count": {"type": "integer", "minimum": 0},
    "state": {"enum": ["represented", "with_gaps", "revalidation_required"]},
    "generated_at": {"type": "integer", "minimum": 0},
    "requires_human_review": {"const": true},
    "automated_compliance_scoring_enabled": {"const": false},
    "framework_applicability_determined": {"const": false},
    "control_effectiveness_determined": {"const": false},
    "legal_compliance_determined": {"const": false},
    "regulatory_compliance_determined": {"const": false},
    "supervisory_acceptance_determined": {"const": false},
    "schema_version": {"const": "datagovops.control-evidence-matrix.v1"}
  }
}
