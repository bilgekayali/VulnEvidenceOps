{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Control Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "institution_id",
    "control_id",
    "control_version",
    "title",
    "domain",
    "owner_id",
    "objective",
    "evidence_requirements",
    "framework_references",
    "registered_at",
    "framework_applicability_determined",
    "legal_compliance_determined",
    "schema_version"
  ],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "control_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "control_version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "domain": {
      "enum": [
        "data_governance",
        "bcbs239_assurance",
        "privacy_security",
        "recovery_resilience",
        "deployment_runtime",
        "release_integrity"
      ]
    },
    "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2048},
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_type", "accepted_sources"],
        "properties": {
          "evidence_type": {"type": "string", "minLength": 1, "maxLength": 256},
          "accepted_sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "bcbs239",
                "access_retention_privacy",
                "security",
                "recovery",
                "deployment",
                "release_evidence",
                "governance_dossier",
                "external"
              ]
            }
          }
        }
      }
    },
    "framework_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "reference", "mapping_rationale", "applicability_determined"],
        "properties": {
          "framework": {"type": "string", "minLength": 1, "maxLength": 256},
          "reference": {"type": "string", "minLength": 1, "maxLength": 512},
          "mapping_rationale": {"type": "string", "minLength": 1, "maxLength": 2048},
          "applicability_determined": {"const": false}
        }
      }
    },
    "registered_at": {"type": "integer", "minimum": 0},
    "framework_applicability_determined": {"const": false},
    "legal_compliance_determined": {"const": false},
    "schema_version": {"const": "datagovops.control-definition.v1"}
  }
}
